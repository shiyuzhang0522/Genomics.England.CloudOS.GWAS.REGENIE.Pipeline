/*
============================================================
Nextflow configuration

GEL AggV3 VEP annotation extraction

CloudOS compatible

============================================================
*/


params {

    manifest = null

    outdir = "results"

}



/*
============================================================
Docker container
============================================================
*/


docker {

    enabled = true

}



/*
============================================================
Process resources
============================================================
*/


process {


    container =
        "ghcr.io/shiyuzhang0522/gel-vep-extractor:v1.1.0"



    errorStrategy =
        "retry"



    maxRetries =
        2



    withName: EXTRACT_VEP_ANNOTATION {


        cpus = 4

        memory = "8 GB"

        time = "48h"


    }



    withName: SUMMARY {


        cpus = 1

        memory = "1 GB"

        time = "1h"


    }


}



/*
============================================================
CloudOS execution settings
============================================================
*/


singularity {

    enabled = false

}



