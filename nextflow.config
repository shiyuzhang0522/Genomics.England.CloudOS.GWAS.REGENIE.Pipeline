/*
============================================================
CloudOS AWS Batch configuration

GEL AggV3 VEP Annotation Extractor

============================================================
*/


process {

    executor = "awsbatch"


    errorStrategy = "terminate"


    withName:EXTRACT_VEP_ANNOTATION {

        cpus = 4

        memory = '8 GB'

        time = '48h'

    }


    withName:SUMMARY {

        cpus = 1

        memory = '2 GB'

    }

}



aws {

    region = "eu-west-2"

}



docker {

    enabled = true

}



params {


    outdir = "results"


}
