/*
Genomics England CloudOS GWAS / REGENIE Pipeline

Task:
REGENIE Step 2 genome-wide association testing

Configuration:

- Platform:
  Genomics England CloudOS
  AWS Batch executor

- Software:
  REGENIE v4.1.2

- Container:
  ghcr.io/shiyuzhang0522/regenie:4.1.2

- Analysis:
  Cutaneous melanoma GWAS
  chr1-22 parallel execution

- Output:
  regenie.step2.GWAS/

===============================================================================
*/


// ============================================================================
// Pipeline parameters
// ============================================================================

params {

    // ------------------------------------------------------------------------
    // REGENIE container
    // ------------------------------------------------------------------------

    regenie_image =
        'ghcr.io/shiyuzhang0522/regenie:4.1.2'


    // ------------------------------------------------------------------------
    // Output directory
    // ------------------------------------------------------------------------

    outdir =
        'regenie.step2.GWAS'


    // ------------------------------------------------------------------------
    // REGENIE Step 2 parameters
    // ------------------------------------------------------------------------

    // Block size for genotype processing
    bsize =
        400
}



// ============================================================================
// Process configuration
// ============================================================================

process {

    /*
    ---------------------------------------------------------------------------
    Container configuration

    Define globally rather than inside a profile.

    This ensures AWS Batch receives a valid Docker image even when CloudOS
    does not explicitly activate a Nextflow profile.
    ---------------------------------------------------------------------------
    */

    container =
        params.regenie_image



    /*
    ---------------------------------------------------------------------------
    Default error handling

    Genuine process/software failures terminate the workflow unless overridden
    for a specific process below.
    ---------------------------------------------------------------------------
    */

    errorStrategy =
        'terminate'



    /*
    ---------------------------------------------------------------------------
    REGENIE Step 2 GWAS

    One task per chromosome:
        chr1 ... chr22

    Expected workload:
        ~88k samples
        ~450k QC variants (step 1)
        chromosome-level WGS association testing

    Transient infrastructure failures:
        exit 143 = SIGTERM / EC2 host termination
        exit 137 = SIGKILL, potentially infrastructure-related or OOM

    These failures are retried automatically up to 3 times.
    Other errors terminate the workflow.
    ---------------------------------------------------------------------------
    */

    withName: REGENIE_STEP2 {

        cpus =
            16


        memory =
            '40 GB'


        time =
            '7d'


        /*
        Retry transient node / host termination while allowing
        other chromosome tasks to continue running.
        */

        errorStrategy = {
            task.exitStatus in [137, 143]
                ? 'retry'
                : 'terminate'
        }


        maxRetries =
            3


        /*
        Keep execution in the task work directory.
        */

        scratch =
            false
    }
}



// ============================================================================
// CloudOS execution profiles
// ============================================================================

profiles {

    /*
    ---------------------------------------------------------------------------
    Docker execution profile

    CloudOS AWS Batch uses container execution.
    The image is already defined globally above.
    ---------------------------------------------------------------------------
    */

    docker {

        docker.enabled =
            true
    }
}