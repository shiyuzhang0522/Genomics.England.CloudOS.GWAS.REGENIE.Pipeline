params {

    // Container
    plink2_image = 'ghcr.io/shiyuzhang0522/gel-gwas-regenie-plink2:alpha7-20260808'

    // Shared QC thresholds
    maf  = 0.01
    geno = 0.01
    hwe  = 1e-15

    // Output directory
    outdir = 'results'
}


process {

    errorStrategy = 'terminate'

    withName: SHARED_QC {
        cpus   = 4
        memory = '16 GB'
    }
}


profiles {

    docker {

        docker.enabled = true

        process.container = params.plink2_image
    }
}