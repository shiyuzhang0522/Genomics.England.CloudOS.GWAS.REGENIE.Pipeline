/*
===============================================================================
GEL CloudOS | REGENIE Step 2 rare melanocyte cCRE association analysis
Author: Shelley

Companion: main.nf
Software: ghcr.io/shiyuzhang0522/regenie:4.1.2

CloudOS supplies AWS Batch, queue, workDir, and data-access configuration.
Do not use interactive-session /home/vscode paths for pipeline inputs.

Default design: 22 chromosomes x 5 masks x 3 AAF thresholds = 330 tasks.
Scientific settings are fixed in main.nf to match the supplied UKBB analysis.
Resource settings below are starting allocations, not measured requirements.
===============================================================================
*/


// ============================================================================
// Step 1. Required CloudOS input parameters
// ============================================================================

params {

    pgen_root = null
    // <root>/chrom-N/postproc-pgen/dragen.{pgen,pvar,psam}

    variant_list_dir = null
    // <directory>/chrN.PASS_or_LowMLSQ.variant_ids.txt
    // Site QC only: PASS or LowMLSQ; no pre-applied AF/MAF/MAC filter.

    gnomad_exclude_dir = null
    // <directory>/chrN.variant.list
    // Same exclusion list as UKBB: gnomAD joint NFE AF > 0.01.
    // GEL IDs retain chrCHROM:POS:REF:ALT and have no DRAGEN: prefix.

    pheno_file = null
    // Same GEL GWAS phenotype file: FID IID CM; CM = 0/1/NA.

    covar_file = null
    // Same GEL GWAS covariates: genetic_sex, study_source, year_of_birth,
    // PC1-PC20. All covariate columns are used, as in the GWAS framework.

    step1_loco = null
    // Actual GEL_CM_REGENIE_step1_1.loco file, not the original pred.list.

    mask_dir = null
    // Select the REGENIE_cCRE_masks parent directory.
    // <directory>/chrN/MASK/chrN.MASK.{annotation,setlist}.txt
    // <directory>/chrN/MASK/MASK.mask.def


    // ========================================================================
    // Step 2. Task selection and output organization
    // ========================================================================

    chromosomes = '1-22'
    masks = 'CADD,GERP,JARVIS,FUNC_ALL,ALL'
    aaf_thresholds = '0.01,0.001,0.0001'

    outdir = 'Rare-cCRE/Results'
    // <outdir>/<mask>/AAF_<AAF>/chrN.Melanocyte_cCRE.<mask>.AAF_<AAF>_CM.regenie
    // Logs and QC summaries: <outdir>/<mask>/AAF_<AAF>/logs/

    help = false


    // ========================================================================
    // Step 3. Software and resources
    // ========================================================================

    regenie_image = 'ghcr.io/shiyuzhang0522/regenie:4.1.2'

    task_cpus = 16
    task_memory = '40 GB'
    task_time = '7d'
    // No workflow-level concurrency cap: CloudOS/AWS Batch schedules tasks.
}


// ============================================================================
// Step 4. Task execution and retry policy
// ============================================================================

executor.exitReadTimeout = '10 min'

process {

    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: REGENIE_RARE_CCRE {

        container = params.regenie_image
        cpus = params.task_cpus
        memory = params.task_memory
        time = params.task_time

        // Retry interrupted/killed tasks only. Input and REGENIE errors fail
        // immediately. A repeat OOM needs a larger task_memory allocation;
        // retrying does not automatically increase memory.
        errorStrategy = {
            task.exitStatus in [137, 143] ? 'retry' : 'terminate'
        }
        maxRetries = 2
    }
}


// ============================================================================
// Step 5. Workflow provenance
// ============================================================================

manifest {
    name = 'GEL REGENIE rare-cCRE association pipeline'
    author = 'Shelley'
    description = 'GEL AggV3 rare-cCRE tests with UKBB-matched REGENIE settings'
    version = '1.0.0'
    nextflowVersion = '>=22.10.0'
}

// Timestamped names avoid overwriting reports from previous submissions.
def report_stamp = new Date().format('yyyyMMdd_HHmmss_SSS')

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${report_stamp}.tsv"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${report_stamp}.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${report_stamp}.html"
}


// ============================================================================
// Step 6. Optional local Docker profile
// ============================================================================

profiles {
    docker {
        docker.enabled = true
    }
}
