/*
Genomics England CloudOS GWAS / REGENIE Pipeline

Task:
REGENIE Step 2 genome-wide association testing

Configuration:

- Platform:
  Genomics England CloudOS
  AWS Batch executor

- Software:
  REGENIE v4.1.2

- Container:
  ghcr.io/shiyuzhang0522/regenie:4.1.2

- Analysis:
  Cutaneous melanoma GWAS
  chr1-22 parallel execution

- Output:
  regenie.step2.GWAS/

===============================================================================
*/


// ============================================================================
// Pipeline parameters
// ============================================================================

params {

    // ------------------------------------------------------------------------
    // REGENIE container
    // ------------------------------------------------------------------------

    regenie_image =
        'ghcr.io/shiyuzhang0522/regenie:4.1.2'


    // ------------------------------------------------------------------------
    // Output directory
    // ------------------------------------------------------------------------

    outdir =
        'regenie.step2.GWAS'


    // ------------------------------------------------------------------------
    // REGENIE Step 2 parameters
    // ------------------------------------------------------------------------

    bsize =
        400
}



// ============================================================================
// Executor robustness
// ============================================================================
//
// CloudOS Fusion/S3-backed filesystem may require additional time for
// output synchronization after task completion.
//
// This avoids premature output validation in large parallel workflows.
//
// ============================================================================

executor {

    exitReadTimeout =
        '10 min'
}



// ============================================================================
// Process configuration
// ============================================================================

process {


    // ------------------------------------------------------------------------
    // Container configuration
    // ------------------------------------------------------------------------

    container =
        params.regenie_image



    // ------------------------------------------------------------------------
    // Default error handling
    // ------------------------------------------------------------------------

    errorStrategy =
        'terminate'



    // ------------------------------------------------------------------------
    // REGENIE Step 2 GWAS
    //
    // One task per chromosome:
    // chr1 ... chr22
    //
    // Expected workload:
    // ~88k samples
    // ~450k QC variants
    //
    // ------------------------------------------------------------------------

    withName: REGENIE_STEP2 {


        cpus =
            16


        memory =
            '40 GB'


        time =
            '7d'



        /*
        Retry transient infrastructure/output synchronization failures.

        Important:
        Previous failure showed:
            exit status = 0
            output file missing

        Therefore restricting retry to
            [137,143]
        would not catch this class of failure.
        */

        errorStrategy =
            'retry'


        maxRetries =
            3



        /*
        Keep execution in task work directory.
        */

        scratch =
            false
    }

}



// ============================================================================
// CloudOS execution profiles
// ============================================================================

profiles {


    docker {

        docker.enabled =
            true

    }

}